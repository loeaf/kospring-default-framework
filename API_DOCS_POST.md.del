      },
      "postingStatus": "POSTED",
      "postedAt": "2024-10-08T15:30:00",
      "postingMessage": "이 광고를 게시합니다",
      "targetPlatforms": ["facebook", "instagram", "google"],
      "canModify": false,
      "performanceStats": {
        "views": 1250,
        "clicks": 89,
        "conversions": 12
      }
    }
  ],
  "pagination": {
    "page": 0,
    "size": 20,
    "totalElements": 5,
    "totalPages": 1
  }
}
```

